# Copy to .env.local for real image generation.
OPENAI_API_KEY=sk-...
MOCK_IMAGES=false

# Cloudflare Access identity (required in production).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CREATOR_EMAILS=dev@noholabs.com
DEV_USER_EMAIL=dev@noholabs.com

# Optional overrides:
# OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21   # pinned snapshot (default: gpt-image-2)
# OPENAI_TEXT_MODEL=gpt-5.4-mini              # asset-needs classifier (default)
# OPENAI_IMAGE_SIZE=1536x1024                 # default: 1024x1536 (portrait)
# OPENAI_IMAGE_QUALITY=high                   # low | medium | high | auto (default: medium)
