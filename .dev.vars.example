# Local only. Never set DEV_AUTH on a deployed Worker.
DEV_AUTH=true
DEV_USER_EMAIL=richard@noholabs.com
CREATOR_EMAILS=richard@noholabs.com
MOCK_IMAGES=true

# For real generation, set MOCK_IMAGES=false and uncomment:
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_SIZE=1024x1536
# OPENAI_IMAGE_QUALITY=medium

# Without DEV_AUTH, these must match the Cloudflare Access application:
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=local-auth-smoke
