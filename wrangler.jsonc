{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creative-creator",
  "main": "worker.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "creative-creator" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "creative-creator",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "creative-creator-images" }],
  "queues": {
    "producers": [{ "binding": "GEN_QUEUE", "queue": "creative-generation" }],
    "consumers": [{
      "queue": "creative-generation",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 2,
      "max_retries": 3,
      "retry_delay": 60
    }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "replace-me.cloudflareaccess.com",
    "CF_ACCESS_AUD": "replace-me",
    "CREATOR_EMAILS": "richard@noholabs.com",
    "MOCK_IMAGES": "false"
  },
  "observability": { "enabled": true }
}
