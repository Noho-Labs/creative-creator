# Local dev defaults (no secrets — local Postgres uses trust auth).
# Real secrets (OPENAI_API_KEY) belong in .env.local, which is gitignored.

# Local Postgres (Homebrew, passwordless trust auth as the OS user).
DATABASE_URL=postgresql://richardpoutier@localhost:5432/creative_creator

# Image mode. Default mock => the whole flow runs with zero API spend
# (placeholder PNGs + fake delay). Set to false in .env.local with a real
# OPENAI_API_KEY to generate with gpt-image-2.
MOCK_IMAGES=true

# Where generated images live (gitignored).
DATA_DIR=./data
